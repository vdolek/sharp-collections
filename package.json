{
  "name": "sharp-collections",
  "version": "1.7.3",
  "description": ".NET Linq like collection library for TypeScript and JavaScript.",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run type-check && npm run test && npm run build",
    "test": "ts-mocha --paths -p tsconfig.tests.json 'tests/**/*.spec.ts'"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "Linq",
    "Typescript",
    "Collections",
    "List",
    "LinkedList",
    "Dictionary",
    "HashSet",
    "Stack",
    "Queue",
    "ReadOnly",
    "HashCode",
    "EqualityComparer"
  ],
  "author": "Martin Volek",
  "license": "MIT",
  "homepage": "https://github.com/vdolek/sharp-collections#readme",
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0"
  },
  "devDependencies": {
    "@types/fast-json-stable-stringify": "^2.0.0",
    "@types/chai": "^4.2.15",
    "@types/mocha": "^8.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chai": "^4.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-chai-friendly": "^0.7.4",
    "mocha": "^8.3.0",
    "mocha-param": "^2.0.1",
    "ts-mocha": "^8.0.0",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.3.3"
  }
}
